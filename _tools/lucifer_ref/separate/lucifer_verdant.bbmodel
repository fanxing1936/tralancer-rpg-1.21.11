      "EmissivePower": 1,
      "NaturalEmissive": 0.699999988079071,
      "DeathEmissive": 1,
      "OpacityMaskClipValue": 0.33329999446868896
    },
    "formula": "max((sRGBDecode(auxiliary.rgb).b * Emissive * EmissivePower + sRGBDecode(albedo.rgb) * NaturalEmissive) * DeathEmissive, 0)",
