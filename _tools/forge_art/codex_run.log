def mark(canvas, rows, colors, origin, kind):
    left, top = origin
    points = { (left + column, top + row_index)
               for row_index, row in enumerate(rows.replace(' ', '').split('/'))
               for column, value in enumerate(row) if value == '#' }
    effects = ((-1, 0), (0, -1), (1, 0), (0, 1), (1, 1))
    for point_x, point_y in sorted(points):
        for delta_x, delta_y in effects:
            point = point_x + delta_x, point_y + delta_y
            if point in points or not canvas.getpixel(point)[3]:
                continue
            if kind == 'rune':
                canvas.putpixel(point, colors[2 if delta_x < 0 or delta_y < 0 else 1])
            elif kind == 'stone' and canvas.getpixel(point) in colors[4:9]:
                canvas.putpixel(point, colors[8])
            elif kind == 'source' and canvas.getpixel(point) in colors[3:9]:
                canvas.putpixel(point, colors[2])
    for point_x, point_y in points:
        point = point_x, point_y
        assert canvas.getpixel(point)[3], (kind, rows, point)
        highlight = (point_x, point_y - 1) not in points
        shade = 10 if kind == 'rune' and highlight else 9 if kind == 'stone' or highlight else 8
        canvas.putpixel(point, colors[shade])


def sprites():
    groups = [[(name, paint(rows, palette(values))) for name, (rows, values) in MATERIALS.items()]]
    groups.append([])
    for index, (name, (values, rows, left, top)) in enumerate(SOURCES.items()):
        colors = palette(values) + (GOLD if index < 3 else IRON)
        canvas = paint(SOURCE, colors)
        mark(canvas, rows, colors, (left, top), 'source')
        groups[-1].append(('source_' + name, canvas))
    groups.append([])
    for name, (values, rows) in RUNES.items():
        colors = palette(values)
        canvas = paint(RUNE, colors)
        mark(canvas, rows, colors, (4, 4), 'rune')
        groups[-1].append(('rune_' + name, canvas))
    groups.append([])
    for name, (values, rows) in STONES.items():
        colors = palette(values) + SETTING
        canvas = paint(STONE, colors)
        mark(canvas, rows, colors, (4 if name == 'volley' else 5, 5), 'stone')
        groups[-1].append(('stone_' + name, canvas))
    return groups


def main():
    groups = sprites()
    assert tuple(map(len, groups)) == (5, 6, 13, 7)
    report = {}
    for group_index, group in enumerate(groups):
        if group_index:
            assert len({canvas.getchannel('A').tobytes() for _, canvas in group}) == 1
        for name, canvas in group:
            colors = {pixel[:3] for pixel in canvas.getdata() if pixel[3]}
            alpha = sorted(set(canvas.getchannel('A').getdata()))
            bounds = canvas.getbbox()
            span = max(bounds[2] - bounds[0], bounds[3] - bounds[1])
            assert canvas.size == (16, 16) and alpha == [0, 255] and 13 <= span <= 15
            assert 14 <= len(colors) <= 24, (name, len(colors))
            path = HERE / (name + '.png')
            canvas.save(path)
            report[name] = {'size': list(canvas.size), 'opaque_rgb': len(colors), 'alpha': alpha,
                            'bbox_xyxy_exclusive': list(bounds), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
    result = Image.new('RGBA', (3840, 384))
    with Image.open(HERE.parent / 'raw' / 'ref_style.png') as reference:
        for row, (group, ref_index) in enumerate(zip(groups, (3, 0, 6, 8))):
            left = 64 + 128 * ref_index
            ref = reference.crop((left, 64, left + 64, 128)).resize((16, 16), Image.Resampling.NEAREST)
            for column, (_, icon) in enumerate([*group, ('reference', ref)]):
                result.paste(icon.resize((96, 96), Image.Resampling.NEAREST), (column * 288, row * 96))
    result.save(HERE / 'preview.png')
    (HERE / 'validation.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
    print(f'Validated {len(report)} sprites; preview {result.size}')


if __name__ == '__main__':
    main()
# 装备养成图标：16×16 绘制任务

只画图，不改项目代码；只在 `_tools/forge_art/` 里写文件。

## 流程

分两步。

**第一步：定造型。** 用内置 `image_gen` 生图，开透明背景。
- 每张图只放一组图标，按下面的分组各出一张，保存到 `raw/<组名>.png`。
- 提示词追加到 `raw/REPORT.md`。
- 不要用脚本生成或修改这一步的图。

**第二步：逐像素重画。** 在真实的 16×16 画布上重画，不再用 `image_gen`。
- 写 Python 脚本 `pixel16/draw.py`，用像素矩阵、固定坐标和离散调色板，经 Pillow 输出 PNG。
- 每个图标输出为 `pixel16/<文件名>.png`。
- 第一步的图只作造型参考，不要缩放取色。

## 硬性要求（项目 ART-STYLE.md §4）

- **尺寸：** 每张严格 16×16。Alpha 只有 0 和 255，无半透明、无抗锯齿、无渐变噪点。
- **密度：** 原版 Minecraft 物品的密度，一条线一格宽，不要两格以内的小花纹。
  - 主体包围盒占画布的 13 到 15 格。
- **光源：** 左上。高光在左上，阴影在右下。
- **描边：** 用比本体暗两档的同色相，不用纯黑。
- **层次感（用户明确否决过平涂版本，这一条最重要）：**
  - 每种材质至少 5 档：描边、深影、中间、亮面、高光。
  - 每个图标 14 到 24 色。
  - 体块之间用一档过渡，不要大片同色。
- **禁止：** 文字、边框、背景、投影底、棋盘格；不要复制其他作品的角色或构图。
- **风格参考：** `raw/ref_style.png` 是原版的唱片、石英、钻石、金锭、紫水晶碎片、回响碎片、粗铁、绿宝石、海洋之心、下界之星、燧石，均为真实 16×16，放大显示。
  - 新图的笔触和密度要和它们并排时看得出是同一个游戏。

## 分组与文件名

### 组 1：材料（`raw/materials.png`）

| 文件名 | 名字 | 造型 |
| --- | --- | --- |
| `blank.png` | 器胚 | 一块未成形的暗铁坯料：粗糙长条，一端略尖，表面有锻打的坑点。冷灰铁色，带一点余热的暗橙边。 |
| `soul.png` | 残魂 | 一枚灵魂色晶体：不规则的尖晶簇，青蓝内核发光，外层半透明感用分档表现，右下有暗紫阴影。 |
| `forge_stone.png` | 铸造之石 | 一块方正的打磨石，正面嵌一道橙红的熔线，四边有锤痕。石色暖灰。 |
| `wash_gem.png` | 洗炼钻 | 一颗切面钻石。比原版钻石更冷、更亮，内部有一道流水般的白色折光。 |
| `gild_leaf.png` | 镀金箔 | 一叠薄金箔：两三片斜放、边缘卷起，暗金到圣金三档，叠层之间有阴影线。 |

### 组 2：六源（`raw/sources.png`）

六张共用**完全相同**的唱片剪影和明暗结构，只换颜色和中央符号。剪影参考原版唱片，但要能一眼看出不是原版唱片：
- 外圈加一圈细金属环；
- 中央的标签换成一枚小符印。

| 文件名 | 名字 | 盘面主色（深 / 亮） | 金属环 | 中央符号 |
| --- | --- | --- | --- | --- |
| `source_faith.png` | 信念 | 受难红 #8A1C00 / #FF3300 | 圣金 #D4AF37 | 十字 |
| `source_hope.png` | 希望 | 晨白 #8F8A7A / #F2EEDC | 圣金 | 一颗四芒星 |
| `source_resolve.png` | 不屈 | 赭金 #7A5410 / #E0A93A | 圣金 | 盾 |
| `source_malice.png` | 邪念 | 紫 #5B2C6F / #D97AD9 | 暗铁 #3A3A40 / #6A6A72 / #A0A0A8 | 一只竖瞳眼 |
| `source_hatred.png` | 仇恨 | 血红 #7B241C / #FF5C52 | 暗铁 | 交叉的两道爪痕 |
| `source_pride.png` | 傲慢 | 墨绿 #00491C / #5FD68C | 暗铁 | 王冠 |

神圣三源用圣金环，恶魔三源用暗铁环，并排时阵营一眼可分。

### 组 3：符文（`raw/runes.png`）

十三张共用**完全相同**的符文石板剪影：一块略斜放的扁平石板，上沿有缺口，正面凹刻一个符号。

石板按类别换色：
- **近战：** 赤铜色系，深 #6B2E1A / 中 #A8522E / 亮 #E08A55
- **远程：** 苔绿色系，深 #2E4A1E / 中 #5C8A3A / 亮 #A8D27A
- **护甲：** 钢蓝色系，深 #1E3550 / 中 #3E6A96 / 亮 #8FB8E0

符号要求：
- 凹刻在石板中央，约 7×7 到 8×8，用亮色实心剪影。
- 周围压一圈深色，右下补一格投影，像刻进石头里。

| 文件名 | 名字 | 类别 | 符号 |
| --- | --- | --- | --- |
| `rune_ember.png` | 余烬 | 近战 | 一簇火苗 |
| `rune_echo.png` | 回响 | 近战 | 两道并行的弧形波纹 |
| `rune_execute.png` | 处决 | 近战 | 一把向下的斧刃 |
| `rune_backstab.png` | 背刺 | 近战 | 一把匕首，刃尖朝右下 |
| `rune_bloodpact.png` | 血契 | 近战 | 一滴血 |
| `rune_poise.png` | 蓄势 | 近战 | 一张拉满的弓弦形弧线加中心点 |
| `rune_hunt.png` | 追猎 | 远程 | 准星（圆圈加十字） |
| `rune_split.png` | 裂矢 | 远程 | 一支箭分成三叉 |
| `rune_meteor.png` | 坠星 | 远程 | 一颗带尾迹的下坠星 |
| `rune_recoil.png` | 反震 | 护甲 | 一面盾，外侧有两道反弹线 |
| `rune_lastbreath.png` | 余生 | 护甲 | 一颗心，中间一道裂缝 |
| `rune_stillwater.png` | 静水 | 护甲 | 三道水平的水纹 |
| `rune_swift.png` | 疾行 | 护甲 | 一只带翼的靴子 |

### 组 4：符石（`raw/stones.png`）

七张共用**完全相同**的符石剪影：一颗多面切割的宝石，嵌在一圈暗金托座里（托座 #5C4A1E / #8F7430 / #D4AF37）。
- 宝石按下表换色。
- 宝石内部有一个小符号，用最亮色、约 5×5。
- 宝石要有发光感：内核最亮，向外降一档。

| 文件名 | 名字 | 宝石色（深 / 亮） | 内部符号 |
| --- | --- | --- | --- |
| `stone_rift.png` | 裂地 | 土黄 #6B4A1E / #E0B060 | 一道向下的裂缝 |
| `stone_frost.png` | 寒潮 | 冰蓝 #1E4A6B / #BFE8FF | 雪花 |
| `stone_shadow.png` | 影步 | 暗紫 #2E1E4A / #A88AE0 | 一道弯月形残影 |
| `stone_blood.png` | 血祭 | 暗红 #4A0E12 / #E0505A | 一枚獠牙 |
| `stone_gale.png` | 风墙 | 青白 #2E5A5A / #D8F4EC | 三道弯曲的风线 |
| `stone_volley.png` | 箭雨 | 草绿 #2E4A1E / #B8E07A | 三支向下的短箭 |
| `stone_banner.png` | 战旗 | 赤金 #6B3A10 / #F0C050 | 一面小旗 |

## 交付与自检

- `pixel16/` 下共 31 张 PNG，文件名与上表一致。
- 输出 `pixel16/preview.png`：
  - 四组各占一行，6 倍最近邻放大，图标之间留 2 个图标宽的透明空隙；
  - 每行最右放一个 `ref_style.png` 里的原版物品作对照。
- 写 `pixel16/validation.json`：每张的尺寸、色数、Alpha 取值、包围盒、SHA-256。
- 自己看一遍预览，检查以下几点，不合格就继续改：
  1. 同组剪影是否完全一致；
  2. 符号在 16×16 原大下是否认得出；
  3. 是否比参考图更平。
- 在 `pixel16/REPORT.md` 写说明：每组用了几档明暗、色数、做过哪些自检，以及没做到的地方。

