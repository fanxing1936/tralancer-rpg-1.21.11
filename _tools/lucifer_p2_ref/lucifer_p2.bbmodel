    "animation_timing_contract": {
      "contract": "UE4.22 ConstantKeyLerp endpoint time and shortest-path normalized linear quaternion interpolation; CUE FPS is diagnostic only.",
      "no_time_keys": "K>1: key_time[i]=i*SequenceLength/(K-1); K=1 is constant; K=0 keeps rest.",
      "explicit_frame_keys": "key_time[i]=source_frame_index[i]*SequenceLength/(NumFrames-1)",
      "rotation": "UE FastLerp followed by Normalize (shortest-path NLERP), not CUE SLERP",
      "sources": [
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Build/Build.version",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Engine/Public/Animation/AnimSequenceDecompressionContext.h#L54",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Engine/Public/AnimEncoding.h#L587",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Engine/Public/AnimEncoding.h#L702",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Engine/Public/AnimEncoding_ConstantKeyLerp.h#L264",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Core/Public/Math/Quat.h#L1114",
        "https://github.com/folgerwang/UnrealEngine/blob/99a530d4ccbe6bea1e8f49df20acfeb294006962/Engine/Source/Runtime/Engine/Private/Animation/AnimCompositeBase.cpp#L53",
        "https://github.com/FabianFG/CUE4Parse/blob/920dc1682278d70ee738383b6fbd3a1e9b7523ea/CUE4Parse-Conversion/Animations/PSA/CAnimSequence.cs#L37",
        "https://github.com/FabianFG/CUE4Parse/blob/920dc1682278d70ee738383b6fbd3a1e9b7523ea/CUE4Parse-Conversion/Animations/PSA/CAnimTrack.cs#L78",
        "https://github.com/FabianFG/CUE4Parse/blob/920dc1682278d70ee738383b6fbd3a1e9b7523ea/CUE4Parse-Conversion/Animations/AnimConverter.cs#L27"
      ],
      "provenance": "Pinned public mirror of original UE4.22.3 source, not an Epic-hosted URL or runtime capture. CUE commit is the repository commit in installed NuGet 1.2.1 nuspec.",
      "previous_probe_scope": "Earlier source_idle_validation used the CUE FPS/SLERP reference. Its geometry agreement remains a CUE-reference result, not evidence of original UE playback timing."
    },
    "affine_track_contract": {
      "space": "absolute_BB_world_internal_pixels",
      "storage": "animation.dungeons_affine_tracks[bone_name] = [[time_seconds, row_major_4x4], ...]",
      "application": "Replace accumulated matrix when chain reaches named bone; compose descendants afterward. Clamp outside keys, linearly interpolate 16 matrix components.",
      "normal_policy": "Transported rest normal; full eyelid collapse may have a singular in-plane affine. SVD must support zero scale.",
      "derived": true,
      "source_bone_tracks": "Only original 40 bones have ordinary position/rotation keyframes; all helper/glow hierarchy unchanged."
    },
