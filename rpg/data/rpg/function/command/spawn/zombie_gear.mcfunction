# Roll this mob's RPG gear.  Runs on a fresh selection so that mobs
# summoned by rpg:command/spawn/zombie are outfitted too.
loot replace entity @s weapon.mainhand loot rpg:armor/sword
loot replace entity @s armor.chest loot rpg:armor/chestplate
loot replace entity @s armor.head loot rpg:armor/helmet
loot replace entity @s armor.legs loot rpg:armor/leggings
loot replace entity @s armor.feet loot rpg:armor/boots
