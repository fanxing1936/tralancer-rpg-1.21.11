##《破碎大陆手记》—— 游戏内玩法总览
give @a written_book[minecraft:written_book_content={title:"破碎大陆手记",author:"无名的边缘者",resolved:true,pages:[[{text:"\n"},{text:"  破碎大陆\n",color:"#8B2500",bold:true},{text:"  ─────────\n",color:"#7A6A55"},{text:"\n  Eretz\n  Ha-Shevarim\n\n",color:"#7A6A55",italic:true},{text:"  这片土地上的\n  每一件东西\n  都在向你索取\n",color:"#7A6A55",italic:true}],[{text:"卷零 · 怎么开始\n\n",color:"#1B4F72",bold:true},{text:"先执行一次：\n"},{text:"/function\nrpg:command/give/box\n\n",color:"#8B2500"},{text:"你会拿到几个潜影盒，包含全部装备与材料。\n\n"},{text:"再执行一次记分板初始化：\n"},{text:"/function\nrpg:command/soreboard",color:"#8B2500"}],[{text:"卷一 · 圣与魔\n\n",color:"#1B4F72",bold:true},{text:"这个世界只有一条轴：\n\n"},{text:"圣器",color:"#DAA520",bold:true},{text:" 与 "},{text:"魔器",color:"#8B2500",bold:true},{text:"。\n\n"},{text:"握着魔器的人会慢慢变成它的主人 —— 这不是比喻，是一个每两秒结算一次的数字。"}],[{text:"卷一 · 魔化值\n\n",color:"#1B4F72",bold:true},{text:"上限 100。屏幕下方那条就是它。\n\n"},{text:"持恶魔本体武器 +2\n持罪器 +1\n持圣器 −1\n\n"},{text:"打空缺者 +6\n杀空缺者 +8\n\n"},{text:"两者同时握着会互相抵消。",color:"#7A6A55",italic:true}],[{text:"卷一 · 什么算圣器\n\n",color:"#1B4F72",bold:true},{text:"手持"},{text:"或穿戴",bold:true},{text:"都算：\n\n"},{text:"· 四件驱魔道具\n"},{text:"· 神圣品质的武具\n  （朗基努斯之枪、\n  圣荆棘冠、\n  都灵裹尸布）\n"},{text:"· 加过神圣分支的武器\n\n"},{text:"但魔化过 91，圣器会灼手。",color:"#8B2500"}],[{text:"卷二 · 堕落\n\n",color:"#1B4F72",bold:true},{text:"魔化到顶不会有人来救你。\n\n"},{text:"屏幕上只写四个字：\n"},{text:"堕落开始",color:"#8B2500",bold:true},{text:"。\n\n"},{text:"此后每两秒往下掉一步，共六十步，约九十秒。过半之后一步变两步。"}],[{text:"卷二 · 掉下去的样子\n\n",color:"#1B4F72",bold:true},{text:"躁动 ",color:"#7A6A55"},{text:"攻击+1\n"},{text:"侵蚀 ",color:"#7A6A55"},{text:"攻击+3，视角开始被扯动\n"},{text:"夺舍 ",color:"#7A6A55"},{text:"攻击+6，脚步不听使唤\n"},{text:"临界 ",color:"#7A6A55"},{text:"攻击+10，黑视，"},{text:"手会自己挥出去",color:"#8B2500",bold:true},{text:"\n\n你越来越强，也越来越不是你。",color:"#7A6A55",italic:true}],[{text:"卷二 · 降临\n\n",color:"#1B4F72",bold:true},{text:"六十步走完，有东西从你身上挣出来。\n\n"},{text:"你看不见它 —— 它常驻隐身，只有周身的黑烟能指出位置。\n\n"},{text:"它只待三十秒。\n\n"},{text:"签过契约的人，来的是那一位领主。",color:"#7A6A55",italic:true}],[{text:"卷三 · 空缺者\n\n",color:"#1B4F72",bold:true},{text:"约六分之一的村民是空壳。\n\n"},{text:"平时与常人无异，"},{text:"只有持圣器的人走进十六格才会显形",bold:true},{text:"。\n\n"},{text:"放着不管会蔓延；动手打反而更糟 —— 杀死它，里面的东西会跳到旁边的村民身上。"}],[{text:"卷三 · 驱魔仪式\n\n",color:"#1B4F72",bold:true},{text:"长按"},{text:"驱魔图腾",color:"#DAA520",bold:true},{text:"立起，\n"},{text:"再用"},{text:"驱魔圣水",color:"#DAA520",bold:true},{text:"浇上去点燃。\n\n"},{text:"圣水必须是"},{text:"滞留型",bold:true},{text:"：喷溅型落地即散，图腾感知不到。\n\n"},{text:"六格内净化魔化、驱出空缺者。"}],[{text:"卷三 · 逆圣化\n\n",color:"#1B4F72",bold:true},{text:"魔化正好 100 时点燃图腾，仪式不再净化，而是"},{text:"引燃",color:"#8B2500",bold:true},{text:"。\n\n"},{text:"图腾朝你烧十秒，共十九点伤害。"},{text:"你必须站在七格内熬完。",bold:true},{text:"\n\n熬过去：魔化归零，得三分钟圣痕。\n熬不住：一点没少。"}],[{text:"卷四 · 七十二柱\n\n",color:"#1B4F72",bold:true},{text:"上一卷是走出去的路。这一卷是走进去的路，而且是你自己选的。\n\n"},{text:"契约是一本书。长按右键签下，恩赐与枷锁一并生效。\n\n"},{text:"此后再长按 = 动用柱中之力。"}],[{text:"卷四 · 七位领主\n\n",color:"#1B4F72",bold:true},{text:"路西法 ",color:"#00491c",bold:true},{text:"傲慢\n",color:"#7A6A55"},{text:"利维坦 ",color:"#1B4F72",bold:true},{text:"嫉妒\n",color:"#7A6A55"},{text:"亚巴顿 ",color:"#6A6A70",bold:true},{text:"怠惰\n",color:"#7A6A55"},{text:"别西卜 ",color:"#5A6B1E",bold:true},{text:"暴食\n",color:"#7A6A55"},{text:"萨麦尔 ",color:"#7B241C",bold:true},{text:"暴怒\n",color:"#7A6A55"},{text:"贝利尔 ",color:"#5B2C6F",bold:true},{text:"色欲\n",color:"#7A6A55"},{text:"玛门 ",color:"#B7950B",bold:true},{text:"贪婪\n",color:"#7A6A55"}],[{text:"卷四 · 代价与解约\n\n",color:"#1B4F72",bold:true},{text:"立约本身就在渗：每次结算额外 +1 魔化。贪婪那一柱翻倍。\n\n"},{text:"解约两条路：\n"},{text:"· 逆圣化（连柱位一起烧）\n"},{text:"· 在燃着的图腾旁长按已立约的书\n\n"},{text:"柱位是排他的。",color:"#7A6A55",italic:true}],[{text:"卷五 · 七宗罪的罪器\n\n",color:"#1B4F72",bold:true},{text:"六位领主各留下一件武器。第七件是玛门的弓。\n\n"},{text:"[DEVIL]",color:"#8B2500",bold:true},{text:"玛门\n\n"},{text:"一次射出三根箭。多出的两根凭空而来，不吃箭袋。"}],[{text:"卷五 · 贪婪的账\n\n",color:"#1B4F72",bold:true},{text:"每射一箭，玛门都要从你身上取走一样：经验、钱、血，或者你的下一顿。\n\n"},{text:"满弓后继续持弓，攒满可射出"},{text:"买断",color:"#DAA520",bold:true},{text:"金箭 —— 它"},{text:"必定收费",bold:true},{text:"，五级经验，付不起就拿命抵。"}],[{text:"卷五 · 契约与罪器\n\n",color:"#1B4F72",bold:true},{text:"签下第七柱之后，那把弓"},{text:"不再从你口袋里掏东西",bold:true},{text:" —— 它改从魂上收，每箭多沾两点魔化。\n\n"},{text:"而买断的金箭会顺带把周围的掉落物翻一倍。\n\n"},{text:"同一位魔神，两副面孔。",color:"#7A6A55",italic:true}],[{text:"卷六 · 佣兵小队\n\n",color:"#1B4F72",bold:true},{text:"一个独立分支，不与前面任何一条耦合。\n\n"},{text:"两面旗：\n"},{text:"募兵旗",color:"#DAA520",bold:true},{text:" 招人\n"},{text:"指挥旗",color:"#DAA520",bold:true},{text:" 指挥\n\n"},{text:"上限 4 人。"}],[{text:"卷六 · 五等\n\n",color:"#1B4F72",bold:true},{text:"HAIKU  ",color:"gray",bold:true},{text:" ❤30 ⛊8 ⚔4\n",color:"#7A6A55"},{text:"   8枚 · 40%\n",color:"#7A6A55"},{text:"SONNET ",color:"#57C6D6",bold:true},{text:" ❤40 ⛊14 ⚔6\n",color:"#7A6A55"},{text:"   20枚 · 28%\n",color:"#7A6A55"},{text:"OPUS   ",color:"#A275DE",bold:true},{text:" ❤55 ⛊20 ⚔8\n",color:"#7A6A55"},{text:"   40枚 · 18%\n",color:"#7A6A55"},{text:"FABLE  ",color:"#D9A02B",bold:true},{text:" ❤75 ⛊25 ⚔11\n",color:"#7A6A55"},{text:"   80枚 · 10%\n",color:"#7A6A55"},{text:"MYTHOS ",color:"#FFD700",bold:true},{text:" ❤100 ⛊30 ⚔15\n",color:"#7A6A55"},{text:"   160枚 · 4%\n",color:"#7A6A55"}],[{text:"卷六 · 怎么招\n\n",color:"#1B4F72",bold:true},{text:"身边没人时长按募兵旗：招一名"},{text:"待雇者",bold:true},{text:"到场，不花钱。等级当场掷点。\n\n"},{text:"看着名牌决定雇不雇 —— 再长按一次才是真的雇下他。\n\n"},{text:"不满意就走开重招。",color:"#7A6A55",italic:true}],[{text:"卷六 · 升级\n\n",color:"#1B4F72",bold:true},{text:"潜行 + 募兵旗，对着在编佣兵。\n\n"},{text:"升到某一等，付那一等的"},{text:"全价",bold:true},{text:"。\n\n"},{text:"比掷点贵，但一定成 —— 你买的是确定性。\n\n"},{text:"甲与纹饰随等级换；手上那把武器不动。",color:"#7A6A55",italic:true}],[{text:"卷六 · 指挥\n\n",color:"#1B4F72",bold:true},{text:"指挥旗，副手空着：\n"},{text:"沿视线指定目标，全队压上。\n\n"},{text:"副手拿着武器：\n"},{text:"交给最近的佣兵，他原本那把掉在地上。\n\n"},{text:"潜行 + 副手空 = 跟随/驻守\n"},{text:"潜行 + 副手有物 = 解雇"}],[{text:"卷六 · 为什么不会误伤\n\n",color:"#1B4F72",bold:true},{text:"尸壳是敌对生物，而原版命令没有办法清除一个生物的当前目标。\n\n"},{text:"所以佣兵的索敌半径被设成了"},{text:"零",bold:true},{text:"。它永远不会自己选中任何东西 —— 安全是结构性的，不靠判定去兜。",color:"#7A6A55"}],[{text:"\n"},{text:"  ─────────\n",color:"#7A6A55"},{text:"\n  你手上的力量\n  正在变大。\n\n",color:"#7A6A55",italic:true},{text:"  那不是你的。\n",color:"#8B2500",italic:true},{text:"\n  ─────────\n",color:"#7A6A55"}]]},minecraft:custom_name=[{text:"《破碎大陆手记》",italic:false,color:"#1B4F72",bold:true}],minecraft:enchantment_glint_override=true]
