talic":false,"color":"white"}],["",{"text":"扣除6滴","italic":false,"color":"white"},{"text":"血量","italic":false,"bold":true,"color":"gold"},{"text":"并获得","italic":false,"color":"white"},{"text":"力量三","italic":false,"color":"gold","bold":true}],["",{"text":"+------------------+","italic":false,"color":"white"}]]}}},{slot:7,item:{id:"minecraft:potion",count:1,components:{"minecraft:potion_contents":{custom_color:63450,custom_effects:[{id:conduit_power,duration:600,amplifier:1},{id:dolphins_grace,duration:600,amplifier:1}]},"minecraft:custom_name":["",{"text":"[brave]","italic":false,"color":"aqua","bold":true},{"text":"动物朋友","italic":false,"bold":false}],"minecraft:lore":[["",{"text":"+------------------+","italic":false,"color":"white"}],["",{"text":"这个世界不光属于我们","italic":false,"color":"white"}],["",{"text":"还属于我和我的动物朋友，","italic":false,"color":"white"},{"text":"芝士雪豹","italic":false,"color":"aqua","bold":true}],["",{"text":"+------------------+","italic":false,"color":"white"}]]}}},{slot:8,item:{id:"minecraft:splash_potion",count:1,components:{"minecraft:potion_contents":{custom_color:7733497,custom_effects:[{id:darkness,duration:600,amplifier:1},{id:nausea,duration:600,amplifier:1},{id:slowness,duration:600,amplifier:2}]},"minecraft:custom_name":["",{"text":"[epic]","italic":false,"color":"dark_purple","bold":true},{"text":"疲惫药水","italic":false,"bold":false}],"minecraft:lore":[["",{"text":"+------------------+","italic":false,"color":"white"}],["",{"text":"放大敌人的弱点","italic":false,"color":"white"}],["",{"text":"恶魔","italic":false,"color":"dark_purple","bold":true},{"text":"亲自炼制的","italic":false,"color":"white"},{"text":"邪恶药水","italic":false,"color":"dark_purple","bold":true}],["",{"text":"+------------------+","italic":false,"color":"white"}]]}}},{slot:9,item:{id:"minecraft:potion",count:1,components:{"minecraft:potion_contents":{custom_color:5107200,custom_effects:[{id:speed,duration:600,amplifier:1},{id:jump_boost,duration:600,amplifier:1}]},"minecraft:custom_name":["",{"text":"[epic]","italic":false,"color":"dark_purple","bold":true},{"text":"体能药水","italic":false,"bold":false}],"minecraft:lore":[["",{"text":"+------------------+","italic":false,"color":"white"}],["",{"text":"强化","italic":false,"color":"white"},{"text":"体能","italic":false,"color":"dark_purple","bold":true},{"text":"的神秘魔药","italic":false,"color":"white"}],["",{"text":"劝诫人们","italic":false,"color":"white"},{"text":"强健身体","italic":false,"color":"dark_purple","bold":true}],["",{"text":"+------------------+","italic":false,"color":"white"}]]}}},{slot:10,item:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:"破碎大陆手记",author:"无名的边缘者",resolved:true,pages:[[{text:"",color:"black"},{text:"\n   破 碎 大 陆\n",color:"#8B2500",bold:true},{text:"\n+----------------+\n",color:"dark_gray"},{text:"   Eretz Ha-Shevarim\n\n",color:"#7A6A55",italic:true},{text:"这里的每一样东西，都要向你收费。",color:"#7A6A55",italic:true},{text:"\n+----------------+\n",color:"dark_gray"},{text:"   先读完这本。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷零]",color:"#8B2500",bold:true},{text:"开局",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"对着聊天栏敲一次：\n"},{text:"/function rpg:command/give/box\n",color:"#DAA520"},{text:"全部领取物已按武器、防具、符文、锻造、驱魔、卡巴拉秘仪、上位契约与裁决等类别装箱。"},{text:"\n"},{text:"▸ 剩下的，边走边看。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷一]",color:"#8B2500",bold:true},{text:"两种兵器",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"你捡到的东西分两路。"},{text:"圣器",color:"#DAA520",bold:true},{text:"护着你；"},{text:"魔器",color:"#8B2500",bold:true},{text:"更强，但它认主 —— 认的不是你。"},{text:"\n"},{text:"▸ 握久了，它开始把你当成它的。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷一]",color:"#8B2500",bold:true},{text:"魔化",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"屏幕正下方那条就是，满格 100。\n"},{text:"握着魔器它涨，握着圣器它退，两手都拿就互相抵消。"},{text:"打村子里那些空壳，涨得最快。"},{text:"\n"},{text:"▸ 它不会自己降下去。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷一]",color:"#8B2500",bold:true},{text:"什么算圣器",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"拿在手上或穿在身上都算：驱魔图腾、驱魔圣水、驱魔替死人偶、驱魔天启星、朗基努斯之枪、圣荆棘冠、都灵裹尸布，以及淬过神圣分支的武器（一二三级都算）。"},{text:"\n"},{text:"代价：",color:"white"},{text:"魔化过 91，它们会烫手",color:"#8B2500"}],[{text:"",color:"black"},{text:"[卷一]",color:"#8B2500",bold:true},{text:"圣器护着你",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"身上带着圣器时，"},{text:"谁都蒙不住你的眼",bold:true},{text:"：黑暗与失明无法停留，已经中的也会散。恶魔其余 debuff（中毒、凋零、饥饿、缓慢…）时间减半。"},{text:"\n"},{text:"▸ 伤害照旧 —— 它挡的是看不见，不是打不疼。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"到顶那一刻",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"没有警报，没有提示。屏幕上只浮起四个字："},{text:"堕落开始",color:"#8B2500",bold:true},{text:"。\n"},{text:"然后你会发现自己变强了。"},{text:"\n"},{text:"▸ 那正是要命的地方。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"之后九十秒",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"你的攻击一路往上走。同时视角会被扯开、脚步不听使唤、眼前时不时发黑；到最后，"},{text:"手会自己挥出去",color:"#8B2500",bold:true},{text:"。"},{text:"\n"},{text:"▸ 越强，越不是你。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"它出来了",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"九十秒走完，有东西从你身上挣出去。你看不见它 —— 只能看见它周身那团黑烟。它有七百生命，最多停留十分钟，而且"},{text:"每位五招",bold:true},{text:"，出手时掷一招，并且不会连续重复上一招。第四次出手不掷点，会先蓄势一息半，再立罪约。"},{text:"\n"},{text:"▸ 七柱会在六成生命处锁住；武器不能代替真名与仪式。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"刹车",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"魔化满格时，立一支"},{text:"驱魔图腾",color:"#DAA520",bold:true},{text:"并点燃它。它会朝你烧十秒 —— 站着别动，熬完。"},{text:"\n"},{text:"代价：",color:"white"},{text:"熬不住，一点都不会少",color:"#8B2500"}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"他会做什么·上",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"路西法",color:"#00491C",bold:true},{text:"［失坠／王座回绝］\n",color:"dark_gray"},{text:"  折翼升空／斥退近身者\n"},{text:"利维坦",color:"#1B4F72",bold:true},{text:"［逆潮／海渊重压］\n",color:"dark_gray"},{text:"  重写远近／深度压骨\n"},{text:"亚巴顿",color:"#6A6A70",bold:true},{text:"［停摆／死寂］\n",color:"dark_gray"},{text:"  冻结脚步／无底坑吞声\n"},{text:"别西卜",color:"#5A6B1E",bold:true},{text:"［腐宴／饥啮］\n",color:"dark_gray"},{text:"  群体腐坏／追咬最近者\n"}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"他会做什么·下",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"萨麦尔",color:"#7B241C",bold:true},{text:"［血猎／怒潮］\n",color:"dark_gray"},{text:"  循血突进／赤环斥退\n"},{text:"贝利尔",color:"#5B2C6F",bold:true},{text:"［顾盼／欲障］\n",color:"dark_gray"},{text:"  强转视线／紫幕压制\n"},{text:"玛门",color:"#B7950B",bold:true},{text:"［复利／金牢］\n",color:"dark_gray"},{text:"  经验血税／黄金定身\n"}],[{text:"",color:"black"},{text:"[卷二]",color:"#8B2500",bold:true},{text:"七柱罪约",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"路西法",color:"#00491C",bold:true},{text:"［万蛇加冕］\n",color:"dark_gray"},{text:"利维坦",color:"#1B4F72",bold:true},{text:"［妒海沉城］\n",color:"dark_gray"},{text:"亚巴顿",color:"#6A6A70",bold:true},{text:"［终末收割］\n",color:"dark_gray"},{text:"别西卜",color:"#5A6B1E",bold:true},{text:"［万蝇饕宴］\n",color:"dark_gray"},{text:"萨麦尔",color:"#7B241C",bold:true},{text:"［血怒天罚］\n",color:"dark_gray"},{text:"贝利尔",color:"#5B2C6F",bold:true},{text:"［紫宴朝圣］\n",color:"dark_gray"},{text:"玛门",color:"#B7950B",bold:true},{text:"［黄金终审］\n",color:"dark_gray"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"▸ Actionbar 上层会先用他的本色宣告罪约，下层战斗状态照常显示；蓄势时离开范围，是最清楚的活路。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"村里的空壳",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"六个村民里大概有一个已经不是人了。平时看不出来，"},{text:"带着圣器走近，它才会亮起来",bold:true},{text:"。"},{text:"\n"},{text:"▸ 别急着动手 —— 你杀了它，里面那东西会跳进旁边那个人身上。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"要是它无处可去",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"附近再没有第二个村民时，那东西不会散掉 —— 它"},{text:"自己找了一副躯体",bold:true},{text:"：恶魔当场降临，站在你面前。"},{text:"\n"},{text:"七位领主随机来一位，不看你的契约。它最多停留十分钟。"},{text:"\n"},{text:"▸ 这一只不是来收账的，是来打架的。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"怎么办",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"举着"},{text:"驱魔图腾",color:"#DAA520",bold:true},{text:"长按右键立下，再朝它扔一瓶"},{text:"驱魔圣水",color:"#DAA520",bold:true},{text:"。必须是滞留型的那种 —— 喷溅的一落地就散了。"},{text:"\n"},{text:"▸ 图腾烧起来，方圆六格一起洗干净。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"真名不是自报的名",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"恶魔喊出的名字不能直接写进判词。带着圣器，亲眼见证它的"},{text:"五种招式中的任意三种",color:"#DAA520",bold:true},{text:"，每一种都会留下不可重复的罪证。三证齐全，真名才被仪式承认。"},{text:"\n"},{text:"▸ 重复看同一招没有用；调查记录会一直跟着你。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"四阶段驱魔",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"一、镇压：把领主压到六成生命。\n"},{text:"二、镇魔：真名已知者在旁边点燃图腾。冲击会把众人震到十格外，恶魔则被钉在阵心，随后罪域覆盖战场。\n"},{text:"三、固阵：稳定度从 50 开始；攻击领主，或靠近后右键布置媒介与器物。\n"},{text:"四、裁决：稳定度到 100，再选择消灭、放逐、封印或契约。"},{text:"\n"},{text:"▸ 领主会在镇压处锁血；不查真名，武器解决不了它。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"恶魔会反抗",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"法阵以 50 点稳定度起步，并常驻显示在屏幕下方。攻击与仪式器物令它上升；恶魔出招和挣脱令它下降。\n"},{text:"傲慢伪造名字，嫉妒复制装备，怠惰拖慢时间，暴食吞媒介，暴怒破边，色欲诱人离阵，贪婪索取赎金。"},{text:"\n"},{text:"▸ 到 100 才能裁决；归零则仪式失败，强制进入消灭战。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"七罪压场",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"每位领主都有三套罪域，开幕随机一套，随后继续轮换：王冠／蛇庭／高座，妒海／逆潮／海渊，停摆／收割／深渊，腐宴／蝇幕／饥啮，怒潮／血猎／裂阵，紫宴／顾盼／欲障，金牢／复利／血税。每次罪域都由落域、震荡、终末三段 AOE 构成。"},{text:"\n"},{text:"▸ 四格内是法阵庇护区；阵外才承受完整压场。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"最后的四条路",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"消灭",color:"#FF6B5E",bold:true},{text:"：解除锁血，恶魔以 700 生命狂暴复苏；杀死后取得武器核心。\n"},{text:"放逐",color:"#DAA520",bold:true},{text:"：完整仪式，获得最多净化与稳定回报。\n"},{text:"封印",color:"#62D9E8",bold:true},{text:"：消耗封魔灯，留下可能逃逸的遗物。\n"},{text:"契约",color:"#D596F2",bold:true},{text:"：留下柱之书与对应罪器，同时增加 25 魔化。"}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"驱魔师阅历",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"见证新罪证、正确使用弱点、处理反仪式与完成裁决都会积累独立阅历。等级阈值："},{text:"0 / 40 / 100 / 180 / 280",color:"#DAA520",bold:true},{text:"。\n"},{text:"\n"},{text:"输入 "},{text:"/function rpg:inquest/career",color:"#FFF2A8",bold:true},{text:" 查看档案并选择审判、守护或秘仪路线。"}],[{text:"",color:"black"},{text:"[卷三]",color:"#8B2500",bold:true},{text:"仪式工具",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"靠近活动法阵后主手右键：真名残页展开真名；弱点媒介、银质圣钉、净罪香与三色粉笔直接布下；告解铃打断反仪式；裁决时右键封魔灯直接封印。"},{text:"\n"},{text:"▸ 旧式丢入仍可用；右键只在五格内生效，阵外不会误消耗。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"另一条路",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"上一卷讲怎么爬出来，这一卷讲怎么"},{text:"自己走进去",bold:true},{text:"。你会捡到七本书，每一本背后站着一位。长按右键，就算签了。"},{text:"\n"},{text:"▸ 签下之后，恩赐与枷锁一起生效。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"七位",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"路西法",color:"#00491C",bold:true},{text:" · 傲慢\n",color:"#7A6A55"},{text:"利维坦",color:"#1B4F72",bold:true},{text:" · 嫉妒\n",color:"#7A6A55"},{text:"亚巴顿",color:"#6A6A70",bold:true},{text:" · 怠惰\n",color:"#7A6A55"},{text:"别西卜",color:"#5A6B1E",bold:true},{text:" · 暴食\n",color:"#7A6A55"},{text:"萨麦尔",color:"#7B241C",bold:true},{text:" · 暴怒\n",color:"#7A6A55"},{text:"贝利尔",color:"#5B2C6F",bold:true},{text:" · 色欲\n",color:"#7A6A55"},{text:"玛门",color:"#B7950B",bold:true},{text:" · 贪婪\n",color:"#7A6A55"},{text:"\n+----------------+\n",color:"dark_gray"}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"签了以后",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"再长按那本书，就是动用他的力量。但契约一直在渗 —— 魔化会自己往上爬，你什么都不做也一样。"},{text:"屏幕下方会一直写着你签给了谁。"},{text:"\n"},{text:"代价：",color:"white"},{text:"贪婪那一位，渗得最快",color:"#8B2500"}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"反悔",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"一、熬一次逆圣化，柱位连同污染一起烧掉。\n"},{text:"二、立一支图腾点燃，在它烧着时长按你那本已签的书。"},{text:"\n"},{text:"▸ 两条都要疼一下。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"生命之树",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"长按"},{text:"[秘仪]卡巴拉血契",color:"#D596F2",bold:true},{text:"，法阵会依照朝向平铺。把十枚"},{text:"[源质]",color:"#D596F2",bold:true},{text:"分别带进同名圆心长按；错误位置不会消耗。十处全部归位，主持者只会得到一次"},{text:"[契约]旧约",color:"#D4AF37",bold:true},{text:"。"}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"旧约",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"立约后每二十秒得到一秒恢复 I，每轮魔化少积两点。长按施展"},{text:"[十诫净界]",color:"#D4AF37",bold:true},{text:"：十格内恶魔承受 20% 最大生命伤害；不高于四分之一者直接处决。"},{text:"\n"},{text:"▸ 回响三十秒；冷却与七罪契约各占一条。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"Daath",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"十源质归位后，站进隐藏的 Daath 圆心，手持"},{text:"[秘仪]真·十字架",color:"#D596F2",bold:true},{text:"长按。十件源质会向中央汇聚，旧约与整棵树收束成"},{text:"[契约]新约",color:"#62D9E8",bold:true},{text:"。"},{text:"\n"},{text:"▸ 转化会消耗真·十字架，也会收回旧约。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"新约",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"普通长按："},{text:"[创世净光]",color:"#62D9E8",bold:true},{text:"，前方 20 格造成 25% 最大生命与 15 点基础伤害，冷却 20 秒。\n"},{text:"潜行长按："},{text:"[伊甸敕界]",color:"#FFF2A8",bold:true},{text:"，净化八格战场并庇护同伴，冷却 30 秒。手持七罪契约书长按可无副作用借力，冷却 15 秒。"}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"权柄分授",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"新约的权柄每 2 秒恢复 1 点。打开玩家面板的契约与权柄页：\n"},{text:"[终末圣裁]",color:"#62D9E8",bold:true},{text:"消耗 25 点，覆印下一次恶魔命中，净化并追加伤害；低于 20% 直接斩杀。\n"},{text:"[圣子恩赐]",color:"#FFF2A8",bold:true},{text:"消耗 35 点，救治十二格内最近的一名同伴。"}],[{text:"",color:"black"},{text:"[卷四]",color:"#8B2500",bold:true},{text:"上位契约",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"新约会把魔化条换成权柄完整度，并免疫失明与黑暗。两本上位契约都可在六格内燃着的驱魔图腾旁，手持已立约的书长按解除。"},{text:"\n七柱在调查阶段守住 175 生命；绑定后，神圣伤害会改为加固法阵稳定度。"},{text:"\n"},{text:"▸ 技能提示与五格冷却都由统一 HUD 显示。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷五]",color:"#8B2500",bold:true},{text:"七宗罪",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"七位领主各留下一件东西在人间。拿着它们你会变强，也会更快地脏掉。"},{text:"\n"},{text:"▸ 值不值，你自己算。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷五]",color:"#8B2500",bold:true},{text:"玛门的弓",color:"#B7950B"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"贪婪那一件。一次射三根箭 —— 多出来的两根凭空出现，不吃你的箭。"},{text:"\n"},{text:"▸ 听起来像白捡的。玛门不做白工。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷五]",color:"#8B2500",bold:true},{text:"他怎么收账",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"每射一箭，他从你身上拿走一样：可能是经验，可能是钱，可能是一颗心，也可能是你的下一顿饭。"},{text:"\n"},{text:"▸ 拿哪一样，他说了算。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷五]",color:"#8B2500",bold:true},{text:"买断",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"拉满之后别松手，继续拉。攒够了，射出去的是一支"},{text:"金箭",color:"#DAA520",bold:true},{text:"。"},{text:"\n"},{text:"代价：",color:"white"},{text:"五级经验；掏不出来就拿命抵",color:"#8B2500"}],[{text:"",color:"black"},{text:"[卷五]",color:"#8B2500",bold:true},{text:"若你签了贪婪",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"那把弓不再翻你的口袋，它改从"},{text:"魂上",bold:true},{text:"收 —— 每射一箭，魔化多涨一点。而你的金箭落地时，周围的掉落物会变成两份。"},{text:"\n"},{text:"▸ 同一位，两副面孔。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"花钱雇人",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"这一卷和前面都没关系。你可以一样魔器都不碰，只带着人打。\n"},{text:"募兵旗",color:"#DAA520",bold:true},{text:" 招人　"},{text:"指挥旗",color:"#DAA520",bold:true},{text:" 指挥"},{text:"\n"},{text:"▸ 最多带 4 个。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"五个档次",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"HAIKU ",color:"gray",bold:true},{text:"8枚\n",color:"#DAA520"},{text:"  ❤30 ⛊8 ⚔4\n",color:"#7A6A55"},{text:"SONNET ",color:"#57C6D6",bold:true},{text:"20枚\n",color:"#DAA520"},{text:"  ❤40 ⛊14 ⚔6\n",color:"#7A6A55"},{text:"OPUS ",color:"#A275DE",bold:true},{text:"40枚\n",color:"#DAA520"},{text:"  ❤55 ⛊20 ⚔8\n",color:"#7A6A55"},{text:"FABLE ",color:"#D9A02B",bold:true},{text:"80枚\n",color:"#DAA520"},{text:"  ❤75 ⛊25 ⚔11\n",color:"#7A6A55"},{text:"MYTHOS ",color:"#FFD700",bold:true},{text:"160枚\n",color:"#DAA520"},{text:"  ❤100 ⛊30 ⚔15\n",color:"#7A6A55"}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"怎么招",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"空着手长按募兵旗，会有人走过来站着 —— 不要钱。他什么档次是当场掷出来的，写在名牌上。看得上，再长按一次雇下他。"},{text:"\n"},{text:"▸ 看不上，走开，重来。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"升级",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"潜行着长按募兵旗，对准你已经雇下的人。升一档，付那一档的"},{text:"全价",bold:true},{text:"。"},{text:"\n"},{text:"▸ 比重新招贵，但重新招是碰运气，这个一定成。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"怎么指挥",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"空手长按指挥旗：你看哪儿，他们打哪儿。\n"},{text:"副手拿把武器再长按：交给最近那个人。\n"},{text:"潜行＋空手：跟着走／原地待命\n"},{text:"潜行＋拿东西：遣散"},{text:"\n+----------------+\n",color:"dark_gray"}],[{text:"",color:"black"},{text:"[卷六]",color:"#8B2500",bold:true},{text:"关于他们",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"他们不会自己找架打，也不会误伤你。盔甲是他们自己的，死了也带走；你塞给他的武器会掉在地上。"},{text:"\n"},{text:"▸ 还有：他们不下水。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"第一章·空缺者",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"玩家面板里打开"},{text:"[第一章·空缺者]",color:"#B5D957",bold:true},{text:"，接受维斯珀城调查令。楔子从第十三声钟与互相矛盾的粮册、墓地记录开始。完整流程约 30–60 分钟；队伍共享场景与 Boss 进度，调查、首通和职业档案跟随个人。"},{text:"\n"},{text:"▸ 前线吃人，后方负责忘记那些被吃掉的人。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"会回家的死者",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"先观察餐桌记录、死亡登记与钟楼检材，不要立刻把答案写成疫病或亡灵。名册若写出你的名字，就已经不是替陌生人冒险。"},{text:"五名罪仆之后，让口粮、尸体、灭口三条路线彼此指认。每次案情复盘都记录已知、矛盾与下一步；重开章节档案可随时查看当前梗概。"},{text:"\n"},{text:"▸ 空缺者记得自己是谁，却不知道“自己”是什么意思。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"别西卜的真名",color:"#5A6B1E"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"粮仓的余烬、蝇茧和腐败祭品只会建立真名假说。进入 Boss 第一阶段后，携带圣器亲历五招中的任意三种不同见证，才会正式确认"},{text:"别西卜",color:"#5A6B1E",bold:true},{text:"。"},{text:"\n"},{text:"▸ 弱点媒介：毒马铃薯·腐宴残食。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"万蝇腐宴",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"一、镇压到 420 / 700 生命。\n"},{text:"二、点燃图腾、宣读真名。\n"},{text:"三、用媒介和器具把稳定度推到 100。\n"},{text:"四、选择消灭、放逐、封印或契约。"},{text:"\n"},{text:"▸ 稳定度归零只会重立仪式，不会错误掉出完整罪器。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"缺失的见证",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"教廷故意撕掉了判词中的"},{text:"见证人印",color:"#D4AF37",bold:true},{text:"。四种裁决都有效，却只能击中卡西安留下的空壳；别西卜会逃走，你得到的是所选路线的裁决残响，不是完整核心或真实契约。"},{text:"\n"},{text:"▸ 裁决的是名字，不是饥饿。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"成为边缘者",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"救下还能说出自己姓名的米拉，你会第一次释放未经许可的魔力。教廷随后给出两个选择：被当作污染源处决，或签下终身征召的边缘者入院令。"},{text:"结案后在审判、守护、秘仪中完成第一次强化，并解锁路西法的王冠失窃案。"},{text:"\n"},{text:"▸ 你没有被神选中。你只是为了活下去，成为了武器。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"[卷七]",color:"#8B2500",bold:true},{text:"门从何处来",color:"aqua"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"驱净空缺者，有时会留下一份教区名册。一个空壳散去，会牵出更长的线索；带到远离聚落的旷野再打开。"},{text:"\n"},{text:"证得任一柱真名后，会有人来找你，并留下七柱回廊的信物。"},{text:"\n"},{text:"▸ 线索认得见过它的人。",color:"#7A6A55",italic:true}],[{text:"",color:"black"},{text:"\n"},{text:"\n+----------------+\n",color:"dark_gray"},{text:"\n   你手上的力量\n   正在变大。\n\n",color:"#7A6A55",italic:true},{text:"   那不是你的。\n\n",color:"#8B2500",italic:true},{text:"\n+----------------+\n",color:"dark_gray"}]]},"minecraft:custom_name":[{text:"《破碎大陆手记》",italic:false,color:"#1B4F72",bold:false}],"minecraft:enchantment_glint_override":true}}}]]

