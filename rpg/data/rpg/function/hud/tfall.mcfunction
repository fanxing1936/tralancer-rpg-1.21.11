# 堕落条。魔化钉死在满值之后，这条位置改报还剩多久。
scoreboard players set @s rpg_hud_on 1
scoreboard players operation @s rpg_hud_p = @s rpg_fall
scoreboard players operation @s rpg_hud_p *= #hud_seg rpg_hud
scoreboard players operation @s rpg_hud_p /= #fall_max rpg_hud
execute if entity @s[scores={rpg_hud_p=0}] run data modify storage rpg:hud a set value '["",{"text":"堕落 ","italic":false,"color":"dark_red"},{"text":"▱▱▱▱▱▱▱▱▱▱","italic":false,"color":"#3D2226"},{"text":"  降临将至","italic":false,"color":"dark_red"}]'
