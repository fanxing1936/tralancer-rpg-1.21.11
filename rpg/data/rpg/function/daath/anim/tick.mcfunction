# 影动画（as 载体）。rpg_dtm_anim = 当前片段，rpg_dtm_t = 已播放刻数。
execute unless score @s rpg_dtm_anim matches 0.. run function rpg:daath/anim/init
# 每 4 刻量一次水平位移：走过 8/100 格以上记为在走，没走就回 idle
scoreboard players add @s rpg_dtm_mc 1
execute if score @s rpg_dtm_mc matches 4.. run function rpg:daath/anim/stride
execute if score @s rpg_dtm_anim matches 0 if score @s rpg_dtm_mv matches 1.. run return run function rpg:daath/anim/enter/walk
