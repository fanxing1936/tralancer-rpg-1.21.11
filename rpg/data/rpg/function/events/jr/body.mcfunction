data modify storage rpg:panel ui set value {title:{text:""},body:[],actions:[]}
data modify storage rpg:panel ui.title set value ["",{"text":"旅程","color":"#C9A646","bold":true,"italic":false},{"text":" 𝔍𝔬𝔲𝔯𝔫𝔢𝔶","color":"#8F7430","bold":false,"italic":false}]
