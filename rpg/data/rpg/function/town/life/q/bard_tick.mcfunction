# 每秒（as/at 接了三首歌的玩家）
execute if entity @e[type=minecraft:marker,tag=rpg.tw.at.spawn,distance=..8] run function rpg:town/life/q/bard_bit_1
execute if entity @e[type=minecraft:marker,tag=rpg.tw.at.grave,distance=..8] run function rpg:town/life/q/bard_bit_2
execute if entity @e[type=minecraft:marker,tag=rpg.tw.at.camp,distance=..8] run function rpg:town/life/q/bard_bit_4
