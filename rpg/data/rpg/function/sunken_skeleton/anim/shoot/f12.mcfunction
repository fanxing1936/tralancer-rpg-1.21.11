# shoot 第 12 刻的姿势（每 1 刻一帧，补间 1 刻）。由 add_sunken_skeleton.py 烘焙。
execute on passengers if entity @s[tag=rpg.sk.p.head] run data merge entity @s {start_interpolation:0,interpolation_duration:1,transformation:{translation:[-0.24032f,0.0269f,0.06781f],left_rotation:[0.06395f,0f,0f,0.99795f],scale:[1f,1f,1f],right_rotation:[0f,0f,0f,1f]}}
execute on passengers if entity @s[tag=rpg.sk.p.right_arm] run data merge entity @s {start_interpolation:0,interpolation_duration:1,transformation:{translation:[-0.3125f,-0.60321f,0.24905f],left_rotation:[-0.73728f,0f,0f,0.67559f],scale:[1f,1f,1f],right_rotation:[0f,0f,0f,1f]}}
execute on passengers if entity @s[tag=rpg.sk.p.left_arm] run data merge entity @s {start_interpolation:0,interpolation_duration:1,transformation:{translation:[0.13615f,-0.64244f,0.17635f],left_rotation:[-0.63008f,-0.27988f,-0.26099f,0.67568f],scale:[1f,1f,1f],right_rotation:[0f,0f,0f,1f]}}
