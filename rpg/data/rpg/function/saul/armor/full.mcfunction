# 全身甲（as 载体）。由 add_saul_model.py 生成。
execute on passengers if entity @s[tag=rpg.slm.p.helmet] run data modify entity @s item.components."minecraft:item_model" set value "rpg:saul/helmet"
execute on passengers if entity @s[tag=rpg.slm.p.l_pauldron] run data modify entity @s item.components."minecraft:item_model" set value "rpg:saul/l_pauldron"
