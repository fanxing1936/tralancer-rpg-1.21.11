dialog show @s {"type":"minecraft:multi_action","title":["",{"text":"身份","color":"#E8D9B0","bold":true,"italic":false}],"body":{"type":"minecraft:plain_message","width":320,"contents":["",{"text":"破碎大陆上，每个人生来就带着一种身份。","color":"#9C9A94","bold":false,"italic":false},{"text":"\n","color":"#9C9A94","bold":false,"italic":false},{"text":"有人一生都碰不到魔力；有人生在缝隙里；有人侍奉神；有人身上留着领主的印记。","color":"#9C9A94","bold":false,"italic":false},{"text":"\n","color":"#9C9A94","bold":false,"italic":false},{"text":"\n","color":"#9C9A94","bold":false,"italic":false},{"text":"而圣子、圣灵与弥赛亚，世间各只有一位。","color":"#FFD85A","bold":false,"italic":false},{"text":"\n","color":"#9C9A94","bold":false,"italic":false},{"text":"\n","color":"#9C9A94","bold":false,"italic":false},{"text":"身份只抽一次。","color":"#797979","bold":false,"italic":false}]},"actions":[{"label":{"text":"揭晓我的身份","color":"#FFD85A","bold":true,"italic":false},"action":{"type":"minecraft:run_command","command":"/trigger rpg_ob_do set 1"}}],"columns":1,"can_close_with_escape":false,"pause":false,"after_action":"close"}
