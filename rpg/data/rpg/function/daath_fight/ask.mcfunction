dialog show @s {"type":"minecraft:multi_action","title":["",{"text":"达阿特 ","color":"#AAB4C3","bold":true,"italic":false},{"text":"𝔇𝔞𝔞𝔱𝔥","color":"#8F7430","bold":false,"italic":false}],"body":{"type":"minecraft:plain_message","width":320,"contents":["",{"text":"深渊在你脚下。","color":"#E6DFCF","bold":true,"italic":false},{"text":"\n\n那里只有一个人，穿你的盔甲，拿你背包里的每一把武器，会你的技能。\n\n","color":"#9C9A94","bold":false,"italic":false},{"text":"只能一个人进去。\n失败不掉东西，不会真的死，两分钟后可以再来。\n它会夺走你手里的武器或身上的盔甲，打完一定归还。\n","color":"#9C9A94","bold":false,"italic":false}]},"actions":[{"label":{"text":"踏入深渊","color":"#AAB4C3","bold":true,"italic":false},"action":{"type":"minecraft:run_command","command":"/trigger rpg_sef_do set 31"}},{"label":{"text":"还不是时候","color":"#9C9A94","bold":true,"italic":false},"action":{"type":"minecraft:run_command","command":"/trigger rpg_sef_do set 20"}}],"columns":2,"can_close_with_escape":true,"pause":false,"after_action":"close"}
