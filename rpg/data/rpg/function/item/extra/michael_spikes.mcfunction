# 骨刺的前 10 格。`positioned ^ ^ ^N` 沿放平的视线取点，整条线不需要递归。
execute positioned ^ ^ ^1 run particle block{block_state:{Name:"minecraft:bone_block"}} ~ ~0.5 ~ 0.15 0.45 0.15 0 5
execute positioned ^ ^ ^1 run particle dust_color_transition{from_color:[1.0,0.2,0.0],to_color:[0.3,0.06,0.0],scale:1.4} ~ ~0.7 ~ 0.12 0.5 0.12 0 4
execute positioned ^ ^ ^1 as @e[type=!player,type=!#rpg:no_damage_track,distance=..1.6] run tag @s add rpg.mi.spiked
