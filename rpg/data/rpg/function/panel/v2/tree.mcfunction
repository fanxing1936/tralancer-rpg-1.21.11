execute if score @s rpg_pa_wt = @s rpg_sef run data modify storage rpg:panel nx set value "综合能力够了：先走完一条连着这一阶的路径。"
execute unless data storage rpg:panel {nx:""} run function rpg:panel/v2/next with storage rpg:panel
