execute if score @s rpg_lt_divine matches 2 if score @s rpg_lt_judge matches 1.. run tellraw @s ["",{"text":"圣裁状态：","color":"gray","bold":false,"italic":false},{"text":"已覆印 · 等待下一次恶魔命中","color":"#FFF2A8","bold":true,"italic":false}]
